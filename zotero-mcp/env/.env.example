ZOTERO_MCP_ENV_FILE=env/.env
ZOTERO_DATA_DIR=E:/OneDrive/02_科研/Zotero
ZOTERO_MCP_PORT=8000
ZOTERO_LOCAL=true
ZOTERO_LOCAL_API_BASE=http://host.docker.internal:23119/api
ZOTERO_DB_PATH=/mnt/zotero/zotero.sqlite
ZOTERO_LIBRARY_ID=0
ZOTERO_LIBRARY_TYPE=user
ZOTERO_EMBEDDING_MODEL=jinaai/jina-embeddings-v5-text-small
ZOTERO_EMBEDDING_DEVICE=cuda
ZOTERO_MCP_TOOLSETS=none,discovery,relations,scite,chatgpt-connector

# 仅需要 Zotero Web API 写入或混合模式时填写；本地只读模式可留空。
ZOTERO_API_KEY=
